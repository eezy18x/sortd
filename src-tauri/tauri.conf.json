{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SORTD",
  "version": "0.1.0",
  "identifier": "io.github.eezy18x.sortd",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SORTD",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0e1013"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Your files. Finally under control.",
    "longDescription": "SORTD is a local-first desktop application for understanding, searching, organizing and reclaiming your storage.",
    "copyright": "Copyright (c) 2026 muffle",
    "publisher": "muffle",
    "license": "MIT",
    "homepage": "https://github.com/eezy18x/sortd",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
