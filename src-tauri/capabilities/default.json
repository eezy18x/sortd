{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main SORTD window. Only SORTD's own commands and event listening are granted; there is no filesystem, shell or HTTP access from the webview.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-get-overview",
    "allow-get-job-status",
    "allow-list-locations",
    "allow-add-location",
    "allow-remove-location",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-list-scans",
    "allow-list-directory",
    "allow-get-file-details",
    "allow-set-category-override",
    "allow-query-files",
    "allow-category-stats",
    "allow-search-files",
    "allow-search-suggestions",
    "allow-search-history",
    "allow-record-search",
    "allow-clear-search-history",
    "allow-storage-analysis",
    "allow-start-duplicate-scan",
    "allow-cancel-duplicate-scan",
    "allow-list-duplicate-groups",
    "allow-generate-recommendations",
    "allow-list-recommendations",
    "allow-set-recommendation-status",
    "allow-plan-operations",
    "allow-dry-run-operations",
    "allow-execute-operations",
    "allow-cancel-operations",
    "allow-undo-batch",
    "allow-discard-plan",
    "allow-list-batches",
    "allow-get-batch",
    "allow-list-activity",
    "allow-get-settings",
    "allow-update-settings",
    "allow-pick-organization-root",
    "allow-clear-organization-root",
    "allow-open-file",
    "allow-reveal-file",
    "allow-reveal-directory",
    "allow-check-database",
    "allow-optimize-database",
    "allow-reset-index"
  ]
}
